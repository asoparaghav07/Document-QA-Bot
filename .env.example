# Get your free API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Configurable Groq Chat Model (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Supabase configuration for multi-user persistence (omit to use local SQLite storage.db fallback)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

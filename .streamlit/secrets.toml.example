# Example secrets configuration for Streamlit Community Cloud
# Copy these values into your Streamlit Cloud App Settings -> Secrets

# Required: Groq API Key for LLM inferences (get a free key at https://console.groq.com)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Optional: Groq LLM model name (defaults to openai/gpt-oss-20b if omitted)
GROQ_MODEL = "openai/gpt-oss-20b"

# Optional: Supabase / PostgreSQL database connection URI for multi-user cloud persistence
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# If omitted or unavailable, the application automatically uses local SQLite storage.
SUPABASE_DB_URL = "postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"
